# Unused sub-project and helper scripts.
#
# Anchored with a leading slash — deliberately. A gitignore pattern with a
# trailing slash and NO leading slash matches a directory of that name at ANY
# depth, so a bare `repose-experience/` also matched
# `public/assets/repose-experience/` and quietly excluded all 82 of the
# lifestyle chapter's photographs from the repository. They were on disk
# locally and absent from every deployment, so the chapter opened on its green
# ground with no imagery. Keep these anchored to the project root.
/repose-experience/
/scripts/

# The supplied terrace package and its source GLB. What the site actually
# serves is the copy in `public/models/repose-terrace.glb`, which IS tracked;
# this is the delivery it was taken from, with its 8.6MB of validation renders.
/repose-terrace/
/repose-terrace.glb

# Source/master assets (not used at runtime, large PNGs/WebPs)
public/floor-explorer/repose-floor-explorer-assets/units-master/
public/assets/reception-entry/Reception-done.webp

# The supplied camera masters, kept beside the project but never committed:
# public/assets/{interiors,amenity-videos} hold the web encodes that actually ship.
/media-src/

# Scratch/agent output recordings
/Claude outputs/
